ProgramNode:
  VarDeclNode: int x[20]
  FunDeclNode: int continueSorting
    Params:
      ParamDeclNode: int a[]
      ParamDeclNode: int index
      ParamDeclNode: int temp
    Body:
      CompoundStmtNode:
        Local Decls:
          VarDeclNode: int keepGoing
        Statements:
          IfStmtNode:
            Condition:
              BinaryExprNode (>=):
                VarExprNode: index
                NumExprNode: 1
            Then:
              CompoundStmtNode:
                Statements:
                  ExprStmtNode:
                    AssignExprNode:
                      LHS:
                        VarExprNode: keepGoing
                      RHS:
                        NumExprNode: 1
            Else:
              IfStmtNode:
                Condition:
                  BinaryExprNode (<):
                    VarExprNode: temp
                    VarExprNode: x
                      Index:
                        BinaryExprNode (-):
                          VarExprNode: index
                          NumExprNode: 1
                Then:
                  CompoundStmtNode:
                    Statements:
                      ExprStmtNode:
                        AssignExprNode:
                          LHS:
                            VarExprNode: keepGoing
                          RHS:
                            NumExprNode: 1
                Else:
                  CompoundStmtNode:
                    Statements:
                      ExprStmtNode:
                        AssignExprNode:
                          LHS:
                            VarExprNode: keepGoing
                          RHS:
                            NumExprNode: 0
          ReturnStmtNode:
            VarExprNode: keepGoing
  FunDeclNode: void sort
    Params:
      ParamDeclNode: int a[]
      ParamDeclNode: int size
    Body:
      CompoundStmtNode:
        Local Decls:
          VarDeclNode: int temp
